# Copy to .env for local development. Never commit .env.
SFC_ENV=development
SECRET_KEY_FILE=C:/path/outside/repo/sfc_flask_secret
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# The URL contains no password; the password is read from the protected file.
DATABASE_URL=mysql+pymysql://sfc_app@127.0.0.1:3306/smart_food_supply_chain_dev?charset=utf8mb4
SFC_DB_PASSWORD_FILE=C:/path/outside/repo/sfc_app_password

# Operator CLI only. Never used to serve HTTP requests.
SFC_OPS_DATABASE_URL=mysql+pymysql://sfc_ops@127.0.0.1:3306/smart_food_supply_chain_dev?charset=utf8mb4
SFC_OPS_PASSWORD_FILE=C:/path/outside/repo/sfc_ops_password

# Automated tests use only smart_food_supply_chain_api_test.
SFC_API_TEST_PASSWORD_FILE=C:/path/outside/repo/sfc_api_test_password
